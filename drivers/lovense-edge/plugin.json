{
    "name": "lovense-edge-driver",
    "display_name": "Lovense Edge Driver",
    "version": "1.0.0",
    "sdk_version": "1.0.0",
    "type": "ble_driver",
    "description": "BLE driver for Lovense Edge and Edge 2: dual independent vibration motors",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": { "ble_name_prefix": "LVS-Edge" },
    "config": {
        "motor_1_max_level": {
            "type": "int",
            "default": 20,
            "label": "Motor 1 Max Level",
            "min": 0,
            "max": 20
        },
        "motor_2_max_level": {
            "type": "int",
            "default": 20,
            "label": "Motor 2 Max Level",
            "min": 0,
            "max": 20
        }
    },
    "functions": {
        "map_motor_1": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "motor_1_max_level" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        },
        "map_motor_2": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "motor_2_max_level" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [ { "log": "lovense-edge: connected" }, { "ble_write": "Battery;" } ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "lovense-edge: disconnected" } ] },
        "speed_change": {
            "vars": [ ],
            "actions": [
                { "set": "$speed" },
                { "@map_motor_1": "$_" },
                { "to_string": "$_" },
                { "concat": [ "Vibrate:", "$_", ";" ] },
                { "ble_write": "$_" },
                { "set": "$speed" },
                { "@map_motor_2": "$_" },
                { "to_string": "$_" },
                { "concat": [ "Vibrate2:", "$_", ";" ] },
                { "ble_write": "$_" }
            ],
            "args": [ "speed" ]
        }
    }
}
