{
    "name": "lovense-driver",
    "display_name": "Lovense Driver",
    "version": "1.0.0",
    "sdk_version": "1.0.0",
    "type": "ble_driver",
    "description": "BLE driver for Lovense single vibration motor toys",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": { "ble_name_prefix": "LVS-" },
    "config": {
        "max_level": {
            "type": "int",
            "default": 20,
            "label": "Vibration Max Level",
            "min": 0,
            "max": 5
        }
    },
    "functions": {
        "map_speed": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "max_level" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [ { "log": "lovense: connected" }, { "ble_write": "Battery;" } ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "lovense: disconnected" } ] },
        "speed_change": {
            "vars": [ ],
            "actions": [
                { "set": "$speed" },
                { "@map_speed": "$_" },
                { "to_string": "$_" },
                { "concat": [ "Vibrate:", "$_", ";" ] },
                { "ble_write": "$_" }
            ],
            "args": [ "speed" ]
        }
    }
}
