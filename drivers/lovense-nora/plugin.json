{
    "name": "lovense-nora-driver",
    "display_name": "Lovense Nora Driver",
    "version": "1.0.0",
    "sdk_version": "1.0.0",
    "type": "ble_driver",
    "description": "BLE driver for Lovense Nora: vibration motor and independently configurable rotation arm",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": { "ble_name_prefix": "LVS-Nora" },
    "config": {
        "max_vibrate": {
            "type": "int",
            "default": 20,
            "label": "Vibration Max Level",
            "min": 1,
            "max": 20
        },
        "max_rotate": {
            "type": "int",
            "default": 12,
            "label": "Rotation Max Level (0 = disabled)",
            "min": 0,
            "max": 20
        }
    },
    "functions": {
        "map_vibrate": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "max_vibrate" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        },
        "map_rotate": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "max_rotate" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [ { "log": "lovense-nora: connected" }, { "ble_write": "Battery;" } ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "lovense-nora: disconnected" } ] },
        "speed_change": {
            "vars": [ "__t0" ],
            "actions": [
                { "set": "$speed" },
                { "@map_vibrate": "$_" },
                { "to_string": "$_" },
                { "concat": [ "Vibrate:", "$_", ";" ] },
                { "ble_write": "$_" },
                { "get_config": "max_rotate", "to": "$__t0" },
                {
                    "if": {
                        "gt": [ "$__t0", 0 ],
                        "then": [
                            { "set": "$speed" },
                            { "@map_rotate": "$_" },
                            { "to_string": "$_" },
                            { "concat": [ "Rotate:", "$_", ";" ] },
                            { "ble_write": "$_" }
                        ]
                    }
                }
            ],
            "args": [ "speed" ]
        }
    }
}
