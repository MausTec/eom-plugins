{
    "name": "lovense-max-driver",
    "display_name": "Lovense Max Driver",
    "version": "1.0.0",
    "sdk_version": "~> 1.1.0",
    "description": "BLE driver for Lovense Max: vibration motor and oscillating pneumatic air actuator",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "eom3k >= 2.0.2" ],
    "permissions": [ "ble:write" ],
    "match": { "ble_name_prefix": "LVS-Max" },
    "config": {
        "max_level": {
            "type": "int",
            "default": 20,
            "label": "Vibration Max Level",
            "min": 0,
            "max": 5
        },
        "air_min": {
            "type": "int",
            "default": 1,
            "label": "Air Min Level",
            "min": 0,
            "max": 5
        },
        "air_max": {
            "type": "int",
            "default": 4,
            "label": "Air Max Level",
            "min": 0,
            "max": 5
        },
        "osc_period_ms": {
            "type": "int",
            "default": 2000,
            "label": "Oscillation Period (ms)",
            "min": 500,
            "max": 10000
        },
        "osc_enabled": { "type": "bool", "default": true, "label": "Enable Air Oscillation" },
        "osc_period_min_ms": {
            "type": "int",
            "default": 400,
            "label": "Oscillation Minimum Period (ms)",
            "min": 200,
            "max": 10000
        },
        "osc_speed_linked": {
            "type": "bool",
            "default": true,
            "label": "Link Oscillation Speed to Vibration Speed"
        }
    },
    "variables": {
        "air_phase": 0,
        "last_toggle_ms": 0,
        "current_air_level": 0,
        "current_period_ms": 2000
    },
    "functions": {
        "set_air_level": {
            "args": [ "arg" ],
            "vars": [ ],
            "actions": [
                { "set": [ "$current_air_level", "$arg" ] },
                { "set": "$current_air_level" },
                { "to_string": "$_" },
                { "concat": [ "Air:Level:", "$_", ";" ] },
                { "ble_write": "$_" }
            ]
        },
        "map_speed": {
            "args": [ "arg" ],
            "actions": [
                { "get_config": "max_level" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        },
        "map_osc_period": {
            "args": [ "arg" ],
            "actions": [
                { "sub": [ 255, "$arg" ], "to": "$__t0" },
                { "get_config": "osc_period_ms", "to": "$__t1" },
                { "get_config": "osc_period_min_ms" },
                { "sub": [ "$__t1", "$_" ] },
                { "mul": [ "$__t0", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "get_config": "osc_period_min_ms", "to": "$__t2" },
                { "add": [ "$_", "$__t2" ] },
                { "return": "$_" }
            ],
            "vars": [ "__t0", "__t1", "__t2" ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [
                { "log": "lovense-max: connected" },
                { "ble_write": "Battery;" },
                { "millis": [ ], "to": "$last_toggle_ms" },
                { "get_config": "osc_period_ms", "to": "$current_period_ms" },
                { "get_config": "air_min" },
                { "@set_air_level": "$_" },
                { "set": [ "$air_phase", 1 ] }
            ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "lovense-max: disconnected" } ] },
        "speed_change": {
            "vars": [ "__t0" ],
            "actions": [
                { "set": "$speed" },
                { "@map_speed": "$_" },
                { "to_string": "$_" },
                { "concat": [ "Vibrate:", "$_", ";" ] },
                { "ble_write": "$_" },
                { "get_config": "osc_speed_linked", "to": "$__t0" },
                {
                    "if": {
                        "neq": [ "$__t0", 0 ],
                        "then": [ { "@map_osc_period": "$speed", "to": "$current_period_ms" } ]
                    }
                }
            ],
            "args": [ "speed" ]
        },
        "tick": {
            "vars": [ "half_period", "now", "elapsed", "__t0" ],
            "actions": [
                { "get_config": "osc_enabled", "to": "$__t0" },
                { "if": { "eq": [ "$__t0", 0 ], "then": [ { "return": 0 } ] } },
                { "div": [ "$current_period_ms", 2 ], "to": "$half_period" },
                { "millis": [ ], "to": "$now" },
                { "sub": [ "$now", "$last_toggle_ms" ], "to": "$elapsed" },
                {
                    "if": {
                        "gte": [ "$elapsed", "$half_period" ],
                        "then": [
                            { "set": [ "$last_toggle_ms", "$now" ] },
                            {
                                "if": {
                                    "eq": [ "$air_phase", 1 ],
                                    "then": [
                                        { "get_config": "air_max" },
                                        { "@set_air_level": "$_" },
                                        { "set": [ "$air_phase", 0 ] }
                                    ],
                                    "else": [
                                        { "get_config": "air_min" },
                                        { "@set_air_level": "$_" },
                                        { "set": [ "$air_phase", 1 ] }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ]
        }
    }
}
