{
    "display_name": "Lovense Max Driver",
    "version": "1.0.0",
    "sdk_version": "~>1.0.0",
    "description": "BLE driver for Lovense Max: vibration motor and oscillating pneumatic air actuator",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": { },
    "config": {
        "maxLevel": {
            "type": "int",
            "default": 20,
            "label": "Vibration Max Level",
            "min": 0,
            "max": 5
        },
        "airMin": {
            "type": "int",
            "default": 1,
            "label": "Air Min Level",
            "min": 0,
            "max": 5
        },
        "airMax": {
            "type": "int",
            "default": 4,
            "label": "Air Max Level",
            "min": 0,
            "max": 5
        },
        "oscPeriodMs": {
            "type": "int",
            "default": 2000,
            "label": "Oscillation Period (ms)",
            "min": 500,
            "max": 10000
        },
        "oscEnabled": { "type": "bool", "default": true, "label": "Enable Air Oscillation" },
        "oscPeriodMinMs": {
            "type": "int",
            "default": 400,
            "label": "Oscillation Minimum Period (ms)",
            "min": 200,
            "max": 10000
        },
        "oscSpeedLinked": {
            "type": "bool",
            "default": true,
            "label": "Link Oscillation Speed to Vibration Speed"
        }
    },
    "variables": {
        "airPhase": 0,
        "lastToggleMs": 0,
        "currentAirLevel": 0,
        "currentPeriodMs": 2000
    },
    "functions": {
        "testReturnType": {
            "args": [ ],
            "vars": [ ],
            "actions": [ { "return": 42 } ],
            "returnType": "int"
        },
        "setAirLevel": {
            "args": [ "arg" ],
            "vars": [ ],
            "actions": [
                { "set": { "$currentAirLevel": "$arg" } },
                { "set": "$currentAirLevel" },
                { "to_string": [ ] },
                { "concat": [ "Air:Level:", "$_", ";" ] },
                { "bleWrite": [ ] }
            ]
        },
        "mapSpeed": {
            "args": [ "arg" ],
            "actions": [
                { "getPluginConfig": "maxLevel" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "return": "$_" }
            ]
        },
        "mapOscPeriod": {
            "args": [ "arg" ],
            "actions": [
                { "sub": [ 255, "$arg" ], "to": "$__t0" },
                { "getPluginConfig": "oscPeriodMs", "to": "$__t1" },
                { "getPluginConfig": "oscPeriodMinMs" },
                { "sub": [ "$__t1", "$_" ] },
                { "mul": [ "$__t0", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "getPluginConfig": "oscPeriodMinMs", "to": "$__t2" },
                { "add": "$__t2" },
                { "return": "$_" }
            ],
            "vars": [ "__t0", "__t1", "__t2" ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [
                { "log": "lovense-max: connected" },
                { "bleWrite": "Battery;" },
                { "millis": [ ], "to": "$lastToggleMs" },
                { "getPluginConfig": "oscPeriodMs", "to": "$currentPeriodMs" },
                { "getPluginConfig": "airMin" },
                { "@setAirLevel": "$_" },
                { "set": { "$airPhase": 1 } }
            ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "lovense-max: disconnected" } ] },
        "speed_change": {
            "vars": [ "level", "__t0" ],
            "actions": [
                { "set": { "$level": 0 } },
                { "@mapSpeed": "$_" },
                { "to_string": [ ], "to": "$level" },
                { "concat": [ "Vibrate:", "$level" ] },
                { "concat": [ "$_", ";" ] },
                { "bleWrite": "$_" },
                { "getPluginConfig": "oscSpeedLinked", "to": "$__t0" },
                {
                    "if": {
                        "neq": [ "$__t0", 0 ],
                        "then": [ { "@mapOscPeriod": "$_", "to": "$currentPeriodMs" } ]
                    }
                }
            ]
        },
        "fake_event": {
            "vars": [ "ival", "array", "iargs", "ukargs", "initargs", "__t0" ],
            "actions": [
                { "set": { "$ival": 0 } },
                { "set": { "$unknownValue": 40 } },
                {
                    "if": { "eq": [ "$ival", 0 ], "then": [ { "set": { "$ival": 10 } } ] }
                },
                { "getbyte": [ "$iargs", 0 ], "to": "$__t0" },
                {
                    "if": {
                        "gt": [ "$__t0", 5 ],
                        "then": [
                            { "getbyte": [ "$iargs", 0 ] },
                            { "concat": [ "iargs[0] is greater than 5", "$_" ] },
                            { "log": "$_" }
                        ]
                    }
                },
                { "getPluginConfig": "unknownConfig", "to": "$ival" },
                { "set": { "$ival": "$unknownIdentifier" } },
                { "set": { "$ival": "$setAirLevel" } },
                { "@setAirLevel": [ ], "to": "$ival" },
                { "@setAirLevel": "$level" },
                { "if": { "neq": [ true, 0 ], "then": [ ] } },
                { "if": { "neq": [ true, 0 ], "then": [ ] } },
                {
                    "if": {
                        "neq": [ true, 0 ],
                        "then": [
                            {
                                "if": {
                                    "neq": [ false, 0 ],
                                    "then": [
                                        { "log": "nested if" },
                                        {
                                            "if": {
                                                "eq": [ "$nestedVar", 0 ],
                                                "then": [ { "log": "nestedVar is zero" } ]
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "tick": {
            "vars": [ "halfPeriod", "now", "elapsed", "__t0" ],
            "actions": [
                { "getPluginConfig": "oscEnabled", "to": "$__t0" },
                { "if": { "eq": [ "$__t0", 0 ], "then": [ { "return": 0 } ] } },
                { "div": [ "$currentPeriodMs", 2 ], "to": "$halfPeriod" },
                { "millis": [ ], "to": "$now" },
                { "sub": [ "$now", "$lastToggleMs" ], "to": "$elapsed" },
                {
                    "if": {
                        "gte": [ "$elapsed", "$halfPeriod" ],
                        "then": [
                            { "set": { "$lastToggleMs": "$now" } },
                            {
                                "if": {
                                    "eq": [ "$airPhase", 1 ],
                                    "then": [
                                        { "getPluginConfig": "airMax" },
                                        { "@setAirLevel": "$_" },
                                        { "set": { "$airPhase": 0 } }
                                    ],
                                    "else": [
                                        { "getPluginConfig": "airMin" },
                                        { "@setAirLevel": "$_" },
                                        { "set": { "$airPhase": 1 } }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ]
        }
    }
}
