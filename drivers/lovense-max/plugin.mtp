# Lovense Max Driver Plugin for EOM3K
#
# Note: This plugin is designed to work with the Lovense Max via BLE. It controls
# the vibration motor and the pneumatic air actuator, which oscillates between a
# minimum and maximum air level at a configurable period. Oscillation speed can
# optionally be linked to the current vibration speed.
#
# Author: Maus-Tec Electronics
# License: MIT
#
# Maus-Tec Electronics is not affiliated with Lovense. This plugin is developed
# independently and is not endorsed by Lovense. This plugin is provided "as is"
# without any warranties.
#
defplugin LovenseMaxDriver do
  @display_name "Lovense Max Driver"
  @version      "1.0.0"
  @sdk_version  "~> 1.1.0"
  @description  "BLE driver for Lovense Max: vibration motor and oscillating pneumatic air actuator"
  @author       "Maus-Tec Electronics"
  @license      "MIT"
  @repository   "https://github.com/maustec/eom-plugins"
  @platforms    ["eom3k >= 2.0.2"]
  @permissions  ["ble:write"]

  match do
    ble_name_prefix "LVS-Max"
  end

  config do
    # Vibration Max Level
    int max_level = 20, min: 0, max: 5

    # Air Min Level
    int air_min = 1, min: 0, max: 5

    # Air Max Level
    int air_max = 4, min: 0, max: 5

    # Oscillation Period (ms)
    int osc_period_ms = 2000, min: 500, max: 10000

    # Enable Air Oscillation
    bool osc_enabled = true

    # Oscillation Minimum Period (ms)
    int osc_period_min_ms = 400, min: 200, max: 10000

    # Link Oscillation Speed to Vibration Speed
    bool osc_speed_linked = true
  end

  globals do
    # Tracks which phase of the air oscillation we are currently in (0 = min, 1 = max)
    int air_phase         = 0

    # Timestamp (ms) of the last time the air level was toggled between min and max
    int last_toggle_ms    = 0
    int current_air_level = 0
    int current_period_ms = 2000
  end

  # Maps a 0-255 speed value to a 0-max_level motor command value.
  fn map_speed = (int arg) -> round(arg * config.max_level / 255)

  # Inverts speed to period: faster speed -> shorter oscillation period.
  fn map_osc_period = (int arg) -> round((255 - arg) * (config.osc_period_ms - config.osc_period_min_ms) / 255) |> add(config.osc_period_min_ms)

  # Sends an air level command and records the current level to globals.
  def set_air_level(int arg) do
    $current_air_level = arg
    $current_air_level |> to_string() |> concat("Air:Level:", $_, ";") |> ble_write()
  end

  on :connect do
    log "lovense-max: connected"
    ble_write "Battery;"

    $last_toggle_ms    = millis()
    $current_period_ms = config.osc_period_ms

    set_air_level config.air_min

    $air_phase = 1
  end

  on :disconnect do
    log "lovense-max: disconnected"
  end

  on :speed_change with speed do
    speed |> map_speed() |> to_string() |> concat("Vibrate:", $_, ";") |> ble_write()
    $current_period_ms = map_osc_period(speed) if config.osc_speed_linked
  end

  on :tick do
    int half_period
    int now
    int elapsed

    return 0 unless config.osc_enabled

    half_period = $current_period_ms / 2
    now         = millis()
    elapsed     = now - $last_toggle_ms

    if elapsed >= half_period do
      $last_toggle_ms = now

      if $air_phase == 1 do
        set_air_level config.air_max
        $air_phase = 0
      else
        set_air_level config.air_min
        $air_phase = 1
      end
    end
  end
end