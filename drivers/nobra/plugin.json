{
    "$schema": "https://schemas.maus-tec.com/mt-actions/v1.0.0/plugin.json",
    "name": "nobra-driver",
    "version": "1.0.0",
    "sdk_version": "1.0.0",
    "display_name": "Nobra Driver",
    "description": "BLE driver for Nobra silicone vibrators",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "type": "ble_driver",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": {
        "ble_service_uuid": "0000ABF0-0000-1000-8000-00805F9B34FB"
    },
    "config": {
        "maxLevel": {
            "type": "int",
            "default": 15,
            "min": 1,
            "max": 15,
            "label": "Max Speed Level"
        }
    },
    "functions": {
        "mapSpeed": {
            "vars": { "maxLevel": 15, "proportion": 0.0, "nobraSpeed": 0, "charCode": 0 },
            "actions": [
                { "getPluginConfig": [ "maxLevel", 15 ], "to": "$maxLevel" },
                { "if": {
                        "eq": [ "$arg", 0 ],
                        "then": [ { "return": "p" } ]
                    } },
                { "div": [ "$arg", 255.0 ], "to": "$proportion" },
                { "mul": [ "$proportion", "$maxLevel" ], "to": "$nobraSpeed" },
                { "round": "$nobraSpeed", "to": "$nobraSpeed" },
                { "add": [ 96, "$nobraSpeed" ], "to": "$charCode" },
                { "chr": "$charCode", "to": "$_" },
                { "return": "$_" }
            ]
        }
    },
    "events": {
        "connect": [
            { "log": "nobra: connected" },
            { "@mapSpeed": { "arg": 0 } },
            { "bleWriteNoResponse": "$_" }
        ],
        "disconnect": [
            { "log": "nobra: disconnected" }
        ],
        "speed_change": [
            { "@mapSpeed": { "arg": "$arg" } },
            { "bleWriteNoResponse": "$_" }
        ]
    }
}