{
    "name": "nobra-driver",
    "display_name": "Nobra Driver",
    "version": "1.0.0",
    "sdk_version": "1.0.0",
    "type": "ble_driver",
    "description": "BLE driver for Nobra silicone vibrators",
    "author": "Maus-Tec Electronics",
    "license": "MIT",
    "repository": "https://github.com/maustec/eom-plugins",
    "platforms": [ "@eom" ],
    "permissions": [ "ble:write" ],
    "match": { "ble_name": "NobraControl" },
    "config": {
        "max_level": {
            "type": "int",
            "default": 15,
            "label": "Max Speed Level",
            "min": 1,
            "max": 15
        }
    },
    "functions": {
        "map_speed": {
            "args": [ "arg" ],
            "vars": [ "char_code" ],
            "actions": [
                { "if": { "eq": [ "$arg", 0 ], "then": [ { "return": "p" } ] } },
                { "get_config": "max_level" },
                { "mul": [ "$arg", "$_" ] },
                { "div": [ "$_", 255 ] },
                { "round": "$_" },
                { "add": [ 96, "$_" ], "to": "$char_code" },
                { "chr": "$char_code" },
                { "return": "$_" }
            ]
        }
    },
    "events": {
        "connect": {
            "vars": [ ],
            "actions": [
                { "log": "nobra: connected" },
                { "@map_speed": 0 },
                { "ble_write_no_response": "$_" }
            ]
        },
        "disconnect": { "vars": [ ], "actions": [ { "log": "nobra: disconnected" } ] },
        "speed_change": {
            "vars": [ ],
            "actions": [ { "@map_speed": "$speed" }, { "ble_write_no_response": "$_" } ],
            "args": [ "speed" ]
        }
    }
}
